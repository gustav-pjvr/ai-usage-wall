{
  "name": "muchbetter-client-wall",
  "productName": "MuchBetter Client Wall",
  "version": "0.9.11",
  "description": "Ambient desktop client wall for MuchBetter. A living, branded showcase of client work.",
  "author": "Gustav (MuchBetter)",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs && node test/projection.test.mjs && node test/projection-crypto.test.mjs && node test/stats-projection.test.mjs && node test/usage-append.test.mjs && node test/chat.test.mjs && node test/pricing.test.mjs",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win dir",
    "logo": "electron scripts/logo.mjs",
    "deploy": "node scripts/deploy.mjs",
    "build:stats": "node build.mjs --edition=stats",
    "start:stats": "npm run build:stats && electron .",
    "package:stats": "npm run build:stats && electron-builder --win --config electron-builder.stats.js",
    "test:e2e": "electron test/projection-e2e.cjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "world.muchbetter.clientwall",
    "productName": "MuchBetter Client Wall",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/readdirp/**/*"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "MuchBetter Client Wall",
      "installerIcon": "assets/logo/icon.ico",
      "uninstallerIcon": "assets/logo/icon.ico"
    },
    "compression": "normal",
    "removePackageScripts": true
  }
}
